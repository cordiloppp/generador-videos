# Copia este archivo como .env y rellena solo las claves que tengas.
# Si una clave falta o está vacía, el script usa el respaldo local automáticamente.

# Groq (transcripción con whisper-large-v3): https://console.groq.com/keys
GROQ_API_KEY=

# Pollinations (imágenes de relleno, fase 4): https://auth.pollinations.ai
POLLINATIONS_TOKEN=

# Cloudflare Workers AI (imágenes de relleno, fase 4)
CF_ACCOUNT_ID=
CF_API_TOKEN=
